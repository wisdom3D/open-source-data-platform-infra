# ==============================================================================
# Nginx Configuration Template - Open Source Data Platform
# Generates isolated vhosts for Airflow and Superset without impacting existing hosts.
# ==============================================================================
# Usage (run from repository root with .env loaded):
#   set -a && source .env && set +a
#   envsubst '${AIRFLOW_DOMAIN} ${SUPERSET_DOMAIN} ${AIRFLOW_HOST_PORT} ${SUPERSET_HOST_PORT}' \
#     < nginx/data-platform.conf.template \
#     | sudo tee /etc/nginx/sites-available/open-source-data-platform.conf
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APACHE AIRFLOW REVERSE PROXY
# ------------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name ${AIRFLOW_DOMAIN};

    client_max_body_size 50M;

    access_log /var/log/nginx/airflow_access.log;
    error_log  /var/log/nginx/airflow_error.log;

    location / {
        proxy_pass http://127.0.0.1:${AIRFLOW_HOST_PORT};

        # Standard Proxy Headers
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket support (Airflow real-time log streaming & task logs)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Timeouts for long-running DAG inspections
        proxy_connect_timeout 300s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;
        proxy_buffering off;
    }
}

# ------------------------------------------------------------------------------
# 2. APACHE SUPERSET REVERSE PROXY
# ------------------------------------------------------------------------------
server {
    listen 80;
    listen [::]:80;
    server_name ${SUPERSET_DOMAIN};

    client_max_body_size 100M;

    access_log /var/log/nginx/superset_access.log;
    error_log  /var/log/nginx/superset_error.log;

    location / {
        proxy_pass http://127.0.0.1:${SUPERSET_HOST_PORT};

        # Standard Proxy Headers
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket & Async Query Support
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Timeouts for SQL Lab queries and dashboard rendering
        proxy_connect_timeout 300s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;
    }
}

