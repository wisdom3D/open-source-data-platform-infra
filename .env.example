# ==============================================================================
# OPEN-SOURCE DATA PLATFORM INFRASTRUCTURE - CONFIGURATION TEMPLATE (.env)
# ==============================================================================
# ASTUCE : Vous pouvez générer automatiquement votre fichier .env complet et
# sécurisé avec des mots de passe aléatoires forts via l'assistant interactif :
#   ./scripts/setup_env.sh
# ==============================================================================

# ==============================================================================
# [OBLIGATOIRE] 1. DOMAINES PUBLICS & REVERSE PROXY NGINX
# ==============================================================================
# Sous-domaines FQDN pointant vers l'adresse IP publique de votre VPS (enregistrements DNS Type A).
# Utilisés par Nginx pour router le trafic et générer les certificats SSL Let's Encrypt.
AIRFLOW_DOMAIN=elt.example.com
SUPERSET_DOMAIN=bi.example.com


# ==============================================================================
# [OBLIGATOIRE / AUTO-GENERE] 2. SECRETS CRYPTOGRAPHIQUES & MOTS DE PASSE
# ==============================================================================
# IMPORTANT : Ne conservez JAMAIS ces valeurs d'exemple en production !
# Toutes ces clés et mots de passe peuvent être auto-générés via ./scripts/setup_env.sh

# --- A. Clés de Chiffrement Applicatives ---
# Clé Fernet Airflow pour chiffrer les connexions de métadonnées (32 octets Base64 url-safe)
# Commande manuelle : python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=replace_with_generated_fernet_key_base64_32bytes=

# Clé secrète de session Webserver Airflow (32 octets Hex)
# Commande manuelle : openssl rand -hex 32
AIRFLOW__WEBSERVER__SECRET_KEY=replace_with_generated_webserver_secret_key_hex32

# Clé secrète obligatoire pour Apache Superset (Flask Secret Key)
# Commande manuelle : openssl rand -base64 42
SUPERSET_SECRET_KEY=replace_with_generated_superset_secret_key_base64

# --- B. Mots de Passe des Bases de Données PostgreSQL ---
# Superutilisateur PostgreSQL (moteur interne conteneur)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_secure_postgres_root_password

# Utilisateur applicatif backend Airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=replace_with_airflow_db_password

# Utilisateur applicatif backend Superset
SUPERSET_DB_USER=superset
SUPERSET_DB_PASSWORD=replace_with_superset_db_password

# Utilisateur de service pour l'exécution dbt (création des tables bronze/silver/gold)
DBT_DB_USER=dbt_runner
DBT_DB_PASSWORD=replace_with_dbt_runner_password

# --- C. Comptes Administrateurs Initiaux des Interfaces Web ---
# Administrateur initial Airflow Web UI
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=replace_with_airflow_admin_password
_AIRFLOW_WWW_USER_EMAIL=admin@example.com
_AIRFLOW_WWW_USER_FIRSTNAME=Platform
_AIRFLOW_WWW_USER_LASTNAME=Admin

# Administrateur initial Superset Web UI
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=replace_with_superset_admin_password
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_ADMIN_FIRSTNAME=Superset
SUPERSET_ADMIN_LASTNAME=Admin


# ==============================================================================
# [OPTIONNEL] 3. PORTS D'ECOUTE, CHEMINS SYSTEME & PARAMETRES AVANCES
# ==============================================================================
# Les valeurs par défaut ci-dessous sont préconfigurées pour un VPS standard et
# isolées sur 127.0.0.1 (aucun conflit avec les services existants de l'hôte).

# --- A. Ports d'écoute sur la boucle locale (127.0.0.1) ---
# POSTGRES_HOST_PORT : 5433 par défaut pour éviter tout conflit avec un Postgres local sur 5432
POSTGRES_HOST_PORT=5433
AIRFLOW_HOST_PORT=8080
SUPERSET_HOST_PORT=8088

# --- B. Chemins & Permissions Hôte ---
# Emplacement sur le VPS où le dépôt dbt externe est synchronisé par l'équipe Data
DBT_PROJECT_HOST_PATH=/opt/dbt-analytics

# Identifiant système du conteneur Airflow (50000 est l'UID officiel)
AIRFLOW_UID=50000

# --- C. Noms des Bases de Données Applicatives & Analytiques ---
POSTGRES_DB=postgres
AIRFLOW_DB=airflow_backend
SUPERSET_DB=superset
ANALYTICS_STAGING_DB=analytics_staging
ANALYTICS_PROD_DB=analytics_prod

# --- D. Limites & Paramètres Superset ---
SUPERSET_ROW_LIMIT=50000

# --- E. Cible de Connexion dbt pour Airflow ---
DBT_TARGET=prod
DBT_PROD_HOST=postgres
DBT_PROD_PORT=5432
DBT_PROD_DB=analytics_prod
DBT_PROD_SCHEMA=public
